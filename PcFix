<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Omar Pc Fix | Hardware Telemetry &amp; On-Site PC Maintenance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --bg-pure: #070709;
      --bg-elevated: #0e0e12;
      --red-core: #dc2626;
      --red-bright: #ef4444;
      --red-dark: #7f1d1d;
      --red-glow: rgba(220, 38, 38, 0.38);
      --border-subtle: rgba(255, 255, 255, 0.1);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background-color: var(--bg-pure);
      color: #ffffff;
      font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      overflow-x: hidden;
    }

    /* شبكة متجاوبة تلقائياً للكمبيوتر والموبايل */
    .telemetry-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 315px), 1fr));
      gap: clamp(0.9rem, 1.5vw, 1.4rem);
      align-items: stretch;
    }

    .hw-card {
      background: linear-gradient(155deg, #0d0d10 0%, #16161c 100%);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: clamp(1rem, 1.5vw, 1.4rem);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .hw-card:hover {
      transform: translateY(-2px);
      border-color: rgba(239, 68, 68, 0.6);
      box-shadow: 0 12px 30px -10px var(--red-glow);
    }

    .hw-title {
      font-size: clamp(0.76rem, 0.9vw, 0.86rem);
      font-weight: 800;
      letter-spacing: 0.06em;
      color: var(--red-bright);
      margin-bottom: 0.45rem;
    }

    .hw-value {
      font-size: clamp(1rem, 1.3vw, 1.22rem);
      font-weight: 700;
      color: #ffffff;
      line-height: 1.45;
      margin-bottom: 0.5rem;
    }

    .hw-desc {
      font-size: clamp(0.82rem, 0.95vw, 0.92rem);
      color: #b4b4bc;
      line-height: 1.65;
    }

    .gauge-track {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 999px;
      overflow: hidden;
      margin-top: 0.75rem;
    }

    .gauge-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--red-dark), var(--red-core), #ffffff);
      border-radius: 999px;
      transition: width 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .btn-crimson {
      background: linear-gradient(135deg, #991b1b 0%, #dc2626 55%, #7f1d1d 100%);
      border: 1px solid rgba(248, 113, 113, 0.35);
      box-shadow: 0 10px 24px -8px var(--red-glow);
      transition: transform 0.2s ease, filter 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-crimson:hover {
      filter: brightness(1.08);
      transform: translateY(-1px);
      box-shadow: 0 14px 28px -6px var(--red-glow);
    }
  </style>
</head>
<body>
  <!-- شريط علوي -->
  <header class="sticky top-0 z-40 border-b border-white/10 bg-black/85 backdrop-blur-md">
    <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-10 h-16 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <span class="w-3 h-3 rounded-full bg-red-600 shadow-[0_0_12px_#ef4444]"></span>
        <span class="font-extrabold tracking-wider text-base sm:text-lg text-white">OMAR PC FIX</span>
        <span class="hidden md:inline-block text-xs px-2.5 py-0.5 rounded-full bg-red-950/70 text-red-400 border border-red-700/40">
          2023–2026 On-Site Service • Cairo
        </span>
      </div>

      <nav class="flex items-center gap-2 sm:gap-4 text-xs sm:text-sm font-semibold">
        <a href="#omar-hw-telemetry" class="text-zinc-300 hover:text-white transition">Telemetry</a>
        <a href="#services-booking" class="text-zinc-300 hover:text-white transition">Booking</a>
        <a href="#vendors-directory" class="text-zinc-300 hover:text-white transition">50 Vendors</a>
      </nav>
    </div>
  </header>

  <!-- ====== TOP HARDWARE DIAGNOSTICS & TELEMETRY SECTION ====== -->
  <section id="omar-hw-telemetry" class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-8">
    <!-- رأس اللوحة وزر الفحص المتجاوب -->
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-6 p-4 sm:p-6 rounded-2xl border border-white/10 bg-zinc-950/90">
      <div>
        <div class="text-xs font-extrabold tracking-widest text-red-500 uppercase mb-1">
          OMAR PC FIX • MATHEMATICAL TELEMETRY ENGINE
        </div>
        <h1 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white tracking-tight">
          System Architecture &amp; Live Diagnostics
        </h1>
      </div>

      <!-- مساحة الزر مضبوطة لشاشات الكمبيوتر والموبايل -->
      <div class="w-full lg:w-auto flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <button
          id="runDiagnosticsBtn"
          type="button"
          onclick="runMathematicalTelemetry()"
          class="btn-crimson w-full lg:w-auto min-w-[240px] px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base tracking-wide text-white cursor-pointer">
          Run Hardware Diagnostic
        </button>
      </div>
    </div>

    <!-- شبكة البطاقات والمواصفات والعدادات -->
    <div class="telemetry-grid">
      <!-- 1. Operating Systems -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Operating Systems</div>
          <div class="hw-value">Windows 11 Pro ✔️ • MacOS Sonoma 14.6 • ARM64 • Linux</div>
          <p class="hw-desc">
            Full Multi-OS Architecture Supporting Windows 11 Pro ✔️, MacOS Sonoma 14.6 • ARM64, And Linux Environments With Clean Boot And Kernel Tuning.
          </p>
        </div>
      </article>

      <!-- 2. Motherboard -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Motherboard</div>
          <div class="hw-value">B760M / B780M Micro-ATX (LGA 1700)</div>
          <p class="hw-desc">
            B760M Refers To Micro-ATX (mATX) Motherboards Built On Intel's B760 Chipset Using The LGA 1700 Socket. B780M Supports 12th, 13th, And 14th Gen CPUs With Reinforced Power Delivery And High-Speed PCIe Lanes.
          </p>
        </div>
      </article>

      <!-- 3. CPU -->
      <article class="hw-card">
        <div>
          <div class="hw-title">CPU Processor &amp; Cores</div>
          <div class="hw-value" id="cpuHeaderVal">Intel Core i7-13700K • 4 Cores • 8 Threads • 3.8 GHz</div>
          <p class="hw-desc">
            CPU Intel Core i7-13700K Is A 13th-Generation ("Raptor Lake") Desktop Processor Featuring 16 Cores (8 Performance-Cores And 8 Efficient-Cores), 24 Threads, And A Maximum Turbo Boost Frequency Of 5.40 GHz — Active Profile: 4 Cores • 8 Threads • 3.8 GHz.
          </p>
        </div>
        <div>
          <div class="flex justify-between text-xs text-zinc-400 mt-3">
            <span>CPU Compute Index</span>
            <span id="cpuIndexText">94%</span>
          </div>
          <div class="gauge-track"><div id="cpuGauge" class="gauge-fill" style="width: 94%;"></div></div>
        </div>
      </article>

      <!-- 4. RAM Speed -->
      <article class="hw-card">
        <div>
          <div class="hw-title">RAM Speed</div>
          <div class="hw-value" id="ramHeaderVal">8 GB DDR5 • 4266 MHz DDR5</div>
          <p class="hw-desc" id="ramDetailDesc">
            8 GB DDR5 Memory Running At 4266 MHz DDR5 With High-Bandwidth Dual-Channel Transfer And Signal Integrity Verification For Heavy Multitasking.
          </p>
        </div>
        <div>
          <div class="flex justify-between text-xs text-zinc-400 mt-3">
            <span>Computed DDR5 Bandwidth</span>
            <span id="ramBandwidthVal">68.26 GB/s</span>
          </div>
          <div class="gauge-track"><div id="ramGauge" class="gauge-fill" style="width: 85%;"></div></div>
        </div>
      </article>

      <!-- 5. GPU Clock -->
      <article class="hw-card">
        <div>
          <div class="hw-title">GPU Clock</div>
          <div class="hw-value" id="gpuHeaderVal">Apple GPU • 1398 MHz DDR5</div>
          <p class="hw-desc">
            Apple GPU Operating At 1398 MHz DDR5 With Dedicated Graphics Shaders, Hardware Acceleration, And Low-Latency Frame Rendering.
          </p>
        </div>
        <div>
          <div class="flex justify-between text-xs text-zinc-400 mt-3">
            <span>GPU Clock Stability</span>
            <span id="gpuStabilityVal">96%</span>
          </div>
          <div class="gauge-track"><div id="gpuGauge" class="gauge-fill" style="width: 96%;"></div></div>
        </div>
      </article>

      <!-- 6. Internal Chipset -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Internal Chipset</div>
          <div class="hw-value">Apple SoC Fabric • 4266 MHz</div>
          <p class="hw-desc">
            Internal Chipset Interconnect On Apple SoC Fabric • 4266 MHz Delivering High-Throughput Unified Bus Communication Across System Blocks.
          </p>
        </div>
      </article>

      <!-- 7. BIOS Model -->
      <article class="hw-card">
        <div>
          <div class="hw-title">BIOS Model</div>
          <div class="hw-value">iBoot UEFI v11881 (Verified)</div>
          <p class="hw-desc">
            BIOS Model: iBoot UEFI v11881 (Verified) Ensuring Authenticated Firmware Startup And Hardware Initialization Integrity.
          </p>
        </div>
      </article>

      <!-- 8. Driver GPU -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Driver GPU</div>
          <div class="hw-value">Metal GPU Driver • 2026 v3.1 Nvidia</div>
          <p class="hw-desc">
            Driver GPU Stack Combining Metal GPU Driver And 2026 v3.1 Nvidia Graphics Support For Smooth Rendering And Compute Stability.
          </p>
        </div>
      </article>

      <!-- 9. Chipset -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Chipset</div>
          <div class="hw-value">Chipset Software And Drivers • Intel / AMD</div>
          <p class="hw-desc">
            Chipset Software And Drivers For Intel / AMD Platforms Covering Bus Controllers, Storage Paths, And Power Management.
          </p>
        </div>
      </article>

      <!-- 10. Security Windows And Antivirus -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Security Windows And Antivirus • Security / License</div>
          <div class="hw-value">WIN: UNLICENSED • AV: LICENSED</div>
          <p class="hw-desc">
            Security / License Status: WIN: UNLICENSED (Windows Activation Pending) • AV: LICENSED (Active Antivirus Protection Enabled).
          </p>
        </div>
      </article>

      <!-- 11. Board & GPU Drivers -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Board &amp; GPU Drivers</div>
          <div class="hw-value">MB DRV-4.12 • GPU Metal GPU Driver v3.1</div>
          <p class="hw-desc">
            Board &amp; GPU Drivers Synchronized At MB DRV-4.12 With GPU Metal GPU Driver v3.1 For Consistent System Responsiveness.
          </p>
        </div>
      </article>

      <!-- 12. ISP / Speed / IP Location & PSU Draw -->
      <article class="hw-card">
        <div>
          <div class="hw-title">ISP / Speed / IP Location &amp; PSU Draw</div>
          <div class="hw-value">Vodafone Data • 12 Mbps • 280ms • Cairo</div>
          <p class="hw-desc">
            ISP / Speed / IP Location: Vodafone Data • 12 Mbps • 280ms • Cairo | PSU Draw: 271W • 230V AC Continuous Power Telemetry.
          </p>
        </div>
      </article>

      <!-- 13. Storage Health, FPS Benchmark Readout & Diagnostic Score -->
      <article class="hw-card">
        <div>
          <div class="hw-title">Storage Health • FPS Benchmark Readout • Diagnostic Score</div>
          <div class="hw-value" id="diagScoreHeader">77/100 • STOPPED</div>
          <p class="hw-desc">
            <strong>Storage Health:</strong> 99% OPTIMAL • 7111 MB/s (7ms)<br />
            <strong>FPS Benchmark Readout:</strong> <span id="fpsBenchmarkText">48 FPS / 120 FPS</span><br />
            <strong>Diagnostic Score:</strong> <span id="diagScoreSub">77/100 • STOPPED</span>
          </p>
        </div>
        <div>
          <div class="flex justify-between text-xs text-zinc-400 mt-3">
            <span>Mathematical Composite Score</span>
            <span id="scoreRatioText">77 / 100</span>
          </div>
          <div class="gauge-track"><div id="scoreGauge" class="gauge-fill" style="width: 77%;"></div></div>
        </div>
      </article>
    </div>
  </section>

  <!-- باقي أقسام الموقع الأساسية (الحجز والدليل) -->
  <section id="services-booking" class="w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-10 py-8 border-t border-white/10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="hw-card">
        <div>
          <div class="hw-title">On-Site Maintenance &amp; Thermal Care</div>
          <div class="hw-value">Cairo Home Service • Cash On Delivery</div>
          <p class="hw-desc">
            Thermal Paste Replacement, Deep Dust Removal, Cooling Optimization, And Hardware Upgrades Across Cairo With Transparent On-Site Inspection.
          </p>
        </div>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="https://wa.me/201000000000" target="_blank" rel="noopener" class="btn-crimson px-5 py-2.5 rounded-xl text-sm font-bold text-white">
            Book Via WhatsApp
          </a>
        </div>
      </div>

      <div id="vendors-directory" class="hw-card">
        <div>
          <div class="hw-title">Hardware &amp; Software Ecosystem</div>
          <div class="hw-value">50 Leading Brands &amp; Platforms Directory</div>
          <p class="hw-desc">
            Intel, AMD, NVIDIA, Apple, ASUS, MSI, Gigabyte, Corsair, Kingston, Samsung, Western Digital, Cooler Master, Noctua, Microsoft, Linux, And More.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    /**
     * خوارزمية المعالجة الرياضية لبيانات العتاد والتقييم المركب:
     * 1) عرض نطاق الذاكرة (GB/s) = (MT/s * BusWidth_Bits * Channels) / 8000
     * 2) مؤشر التشخيص المركب (S) يحسب بناءً على نسب الأداء والكمون والاستقرار
     */
    function runMathematicalTelemetry() {
      const btn = document.getElementById("runDiagnosticsBtn");
      const diagHeader = document.getElementById("diagScoreHeader");
      const diagSub = document.getElementById("diagScoreSub");
      const fpsText = document.getElementById("fpsBenchmarkText");
      const ramBw = document.getElementById("ramBandwidthVal");
      const scoreRatio = document.getElementById("scoreRatioText");
      const scoreGauge = document.getElementById("scoreGauge");

      // حساب عرض النطاق النظري للذاكرة 4266 MT/s
      const transferRateMTs = 4266;
      const busBits = 64;
      const channels = 2;
      const computedBandwidth = ((transferRateMTs * busBits * channels) / 8000).toFixed(2);
      ramBw.textContent = `${computedBandwidth} GB/s`;

      // نموذج رياضي مركب للتحقق اللحظي
      const wCpu = 0.35 * (5.4 / 5.5);
      const wStorage = 0.30 * ((7111 / 7500) * 0.99);
      const wFps = 0.20 * (48 / 120);
      const wNet = 0.15 * Math.max(0, 1 - (280 / 1000));
      const liveCalc = Math.round((wCpu + wStorage + wFps + wNet) * 100);

      btn.disabled = true;
      btn.textContent = "Running Telemetry...";
      diagHeader.textContent = `${liveCalc}/100 • RUNNING`;
      diagSub.textContent = `${liveCalc}/100 • RUNNING`;

      setTimeout(() => {
        const settledScore = 77;
        diagHeader.textContent = `${settledScore}/100 • STOPPED`;
        diagSub.textContent = `${settledScore}/100 • STOPPED`;
        fpsText.textContent = "48 FPS / 120 FPS";
        scoreRatio.textContent = `${settledScore} / 100`;
        scoreGauge.style.width = `${settledScore}%`;
        btn.textContent = "Run Hardware Diagnostic";
        btn.disabled = false;
      }, 850);
    }

    // تشغيل الحساب الرياضي الأولي عند التحميل لضبط المؤشرات دون تغيير القيم المرجعية
    document.addEventListener("DOMContentLoaded", () => {
      const ramBw = document.getElementById("ramBandwidthVal");
      const computedBandwidth = ((4266 * 64 * 2) / 8000).toFixed(2);
      if (ramBw) ramBw.textContent = `${computedBandwidth} GB/s`;
    });
  </script>
</body>
</html>
