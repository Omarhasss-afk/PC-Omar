    function gpuInfo() {
      let raw = '', api = 'WebGL';
      try {
        const c = document.createElement('canvas');
        let g = c.getContext('webgl2');
        const v2 = !!g;
        if (!g) g = c.getContext('webgl');
        if (g) {
          const x = g.getExtension('WEBGL_debug_renderer_info');
          raw = String(x ? g.getParameter(x.UNMASKED_RENDERER_WEBGL) : g.getParameter(g.RENDERER));
          api = v2 ? 'WebGL 2' : 'WebGL 1';
        }
      } catch (e) {}
      const m = raw.match(/^ANGLE \((.*)\)$/), parts = m ? m[1].split(',') : [raw];
      let name = (parts[1] || parts[0] || '')
        .replace(/Direct3D\d*.*$|\(0x[0-9a-f]+\)|vs_\d_\d.*$/ig, '')
        .replace(/^\s*ANGLE Metal Renderer:\s*/i, '')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 40);
      if (/D3D11/i.test(raw)) api = 'Direct3D 11 / ' + api;
      else if (/Metal/i.test(raw) || /^Apple/i.test(raw)) api = 'Metal / ' + api;
      else if (/Vulkan/i.test(raw)) api = 'Vulkan / ' + api;
      const vendor = /NVIDIA|GeForce|RTX|GTX/i.test(name + raw) ? 'NVIDIA'
        : /AMD|Radeon/i.test(name + raw) ? 'AMD'
        : /Intel|Iris|UHD|Arc/i.test(name + raw) ? 'Intel'
        : /Apple/i.test(name + raw) ? 'Apple' : 'Generic';
      return { name: name || 'Integrated GPU', raw, api, vendor };
    }

    function benchMem() {
      const n = 1 << 20, a = new Float64Array(n), b = new Float64Array(n);
      for (let i = 0; i < n; i++) a[i] = i;
      b.set(a);
      const R = 16, t = performance.now();
      for (let r = 0; r < R; r++) b.set(a);
      return (R * n * 8 * 2) / 1e9 / Math.max(1e-3, (performance.now() - t) / 1000);
    }

    function benchGhz() {
      const N = 1.5e7;
      let x = 0;
      const t = performance.now();
      for (let i = 0; i < N; i++) x = (x + i) | 0;
      return { g: N / Math.max(1, (performance.now() - t) * 1e6) * 1.6, x };
    }

