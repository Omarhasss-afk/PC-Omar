    function getSlotLabel(slotId) {
      const found = TIME_SLOTS_10_TO_8.find(s => s.id === slotId);
      if (!found) return slotId || '';
      return currentLang === 'ar' ? found.ar : found.en;
    }

    function getUpcomingDays(count = 7) {
      const days = [];
      for (let i = 0; i < count; i++) {
        const d = new Date();
        d.setDate(d.getDate() + i);
        const iso = toLocalIsoDate(d);
        const label = d.toLocaleDateString(currentLang === 'ar' ? 'ar-EG' : 'en-US', {
          weekday: 'short',
          month: 'short',
          day: 'numeric'
        });
        days.push({ iso, label });
      }
      return days;
    }

    function isSlotBooked(dateStr, slotId) {
      return db.orders.some(o => o.date === dateStr && o.timeSlot === slotId && o.stage !== 'Cancelled');
    }

    function initAndRenderSchedulePicker() {
      const days = getUpcomingDays(7);
      if (!selectedBookingDate || !days.some(d => d.iso === selectedBookingDate)) {
        selectedBookingDate = days[0].iso;
      }

      const daysRow = $id('booking-days-row');
      if (daysRow) {
        daysRow.innerHTML = days.map(d => {
          const active = d.iso === selectedBookingDate;
          return `
            <button type="button" onclick="selectBookingDay('${escapeHtml(d.iso)}')"
              class="px-3.5 py-2 rounded-xl text-xs font-extrabold whitespace-nowrap border transition ${
                active
                  ? 'bg-crimson text-white border-crimsonGlow shadow-md shadow-crimson/25'
                  : 'bg-[#15151E] text-gray-300 border-gray-800 hover:border-amber-400/50 hover:text-white'
              }">
              ${escapeHtml(d.label)}
