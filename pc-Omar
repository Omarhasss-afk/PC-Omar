    function detectGPSLocation() {
      const addrInput = $id('booking-address');
      if (!navigator.geolocation) {
        showToast('المتصفح لا يدعم GPS، تم استخدام موقع IP.');
        return;
      }
      showToast('جارٍ تحديد الموقع الدقيق عبر GPS...');
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const lat = pos.coords.latitude.toFixed(4);
          const lon = pos.coords.longitude.toFixed(4);
          const gpsLoc = `GPS (${lat}, ${lon}) — ${detectedInfo.locationString}`;
          detectedInfo.locationString = gpsLoc;
          if (addrInput) addrInput.value = gpsLoc;
          syncBookingSnapshot();
          showToast('تم إرفاق إحداثيات GPS في الحجز.');
        },
        () => {
          showToast('تم الإبقاء على الموقع التقديري عبر IP.');
        }
      );
    }

    function applyAIDiagnosticsAndServices() {
      const findings = [];
      const recommendedIds = new Set();

      if (maxCpuTemp >= 78 || maxGpuTemp >= 76 || cpuTemp >= 72) {
        findings.push(`Elevated thermal load detected (Peak CPU ${Math.round(maxCpuTemp)}°C / GPU ${Math.round(maxGpuTemp)}°C) — deep cleaning & fresh thermal paste recommended.`);
        recommendedIds.add('cleaning-paste');
      } else {
        findings.push(`Baseline thermals at ${Math.round(cpuTemp)}°C CPU / ${Math.round(gpuTemp)}°C GPU (${cpuClock.toFixed(1)}GHz / ${Math.round(gpuClock)}MHz); thermal maintenance service ready.`);
        recommendedIds.add('cleaning-paste');
      }

      if (detectedInfo.biosNeedsUpdate) {
        findings.push(`BIOS (${detectedInfo.bios}) flagged for firmware update & tuning.`);
        recommendedIds.add('bios-update');
      }

      if (!detectedInfo.boardDriverOk || !detectedInfo.gpuDriverOk || !detectedInfo.winActivated || !detectedInfo.securityLicensed) {
        findings.push(`Driver or license audit item detected (${detectedInfo.driversSummary} | ${detectedInfo.licenseSummary}).`);
        recommendedIds.add('windows-drivers');
      }

      if (minFpsSeen < 35 || isTesting) {
        findings.push(`Frame pacing / stress check flagged performance bottleneck (Min FPS: ${Math.round(minFpsSeen)} FPS).`);
        recommendedIds.add('full-diagnostic');
      }

      db.services.forEach(srv => {
        if (!srv.active) {
          srv.selected = false;
          return;
        }
        if (recommendedIds.has(srv.id)) srv.selected = true;
      });

      const summaryText = findings.join(' ');
      const diagEl = $id('ai-diag-summary');
      const badgeEl = $id('ai-diag-badge');
      const descInput = $id('booking-desc');

      if (diagEl) diagEl.textContent = summaryText;
      const selectedCount = db.services.filter(s => s.active && s.selected).length;
      if (badgeEl) {
        badgeEl.textContent = `${selectedCount} SERVICE(S) SELECTED`;
        badgeEl.className = `text-[11px] font-mono font-bold ${selectedCount > 1 ? 'text-amber-400' : 'text-rose-400'}`;
      }
      if (descInput && !descInput.dataset.userEdited) {
        descInput.value = `${summaryText} [Device: ${detectedInfo.deviceType} | CPU: ${detectedInfo.cpu} | GPU: ${detectedInfo.gpu} | RAM: ${detectedInfo.ram} | FPS: ${Math.round(currentFPS)}/${targetFPS} | ISP: ${detectedInfo.isp} ${detectedInfo.netSpeedMbps}]`;
