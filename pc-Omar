    const GAUGE_STATE = {};
    function buildGauge(id) {
      if (GAUGE_STATE[id]) return;
      const c = $id(id);
      if (!c) return;
      const svg = c.ownerSVGElement;
      const ns = 'http://www.w3.org/2000/svg';
      const defs = document.createElementNS(ns, 'defs');
      defs.innerHTML = `<linearGradient id="gg-${id}" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#7F091A"/><stop offset=".55" stop-color="#E11D48"/><stop offset="1" stop-color="#FF6A3D"/></linearGradient>`;
      svg.insertBefore(defs, svg.firstChild);
      const g = document.createElementNS(ns, 'g');
      for (let i = 0; i <= 36; i++) {
        const a = i * 270 / 36 * Math.PI / 180;
        const major = i % 6 === 0;
        const r1 = 46.5;
        const r2 = major ? 42.5 : 44.5;
        const l = document.createElementNS(ns, 'line');
        l.setAttribute('x1', 50 + r1 * Math.cos(a));
        l.setAttribute('y1', 50 + r1 * Math.sin(a));
        l.setAttribute('x2', 50 + r2 * Math.cos(a));
        l.setAttribute('y2', 50 + r2 * Math.sin(a));
        l.setAttribute('stroke', major ? 'rgba(255,255,255,.5)' : 'rgba(255,255,255,.2)');
        l.setAttribute('stroke-width', major ? 1.2 : 0.8);
        g.appendChild(l);
      }
      const dot = document.createElementNS(ns, 'circle');
      dot.setAttribute('r', 2.6);
      dot.setAttribute('fill', '#fff');
      dot.style.opacity = 0;
      dot.style.filter = 'drop-shadow(0 0 3px #fff)';
      g.appendChild(dot);
      svg.appendChild(g);
      GAUGE_STATE[id] = { max: 0, dot };
    }

    function updateGauge(id, valId, value, max, unit) {
      const circle = $id(id);
      const valText = $id(valId);
      if (!circle || !valText) return;
      buildGauge(id);
      const L = 2 * Math.PI * 40 * 0.75;
      const pct = Math.max(0, Math.min(value / max, 1));
      circle.style.strokeDasharray = `${pct * L}, 251.3`;
      circle.style.stroke = `url(#gg-${id})`;
      circle.style.filter = `drop-shadow(0 0 ${3 + pct * 7}px rgba(255,30,56,${0.25 + pct * 0.6}))`;
      const pk = GAUGE_STATE[id];
      pk.max = Math.max(pk.max, pct);
      const th = pk.max * 270 * Math.PI / 180;
      pk.dot.setAttribute('cx', 50 + 40 * Math.cos(th));
      pk.dot.setAttribute('cy', 50 + 40 * Math.sin(th));
      pk.dot.style.opacity = pk.max > 0.02 ? 1 : 0;
      valText.textContent = `${Math.round(value)}${unit}`;
      valText.style.color = value > 82 ? '#FF1E38' : value > 68 ? '#FBBF24' : '#FFFFFF';
    }

