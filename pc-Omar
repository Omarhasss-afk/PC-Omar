        await fetch(`https://www.cloudflare.com/cdn-cgi/trace?t=${Date.now()}`, { cache: 'no-store', mode: 'no-cors' });
        const measuredRtt = Math.max(6, Math.min(280, Math.round(performance.now() - t0)));
        pingText = `${measuredRtt}ms`;
        if (!conn || !conn.downlink) {
          const estMbps = Math.max(12, Math.min(300, Math.round(2400 / measuredRtt)));
          speedText = `${estMbps} Mbps`;
