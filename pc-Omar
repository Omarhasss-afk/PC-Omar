      const health = elapsed < 40 ? '99% OPTIMAL' : elapsed < 90 ? '95% HEALTHY' : '84% CHECK';
      detectedInfo.storageHealth = `${health} • ${readSpeed} MB/s (${sum ? Math.round(elapsed) : 0}ms)`;

