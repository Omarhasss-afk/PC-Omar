    function loadDatabase() {
      try {
        const raw = localStorage.getItem(APP_CONFIG.dbStorageKey);
        if (!raw) {
          localStorage.setItem(APP_CONFIG.dbStorageKey, JSON.stringify(DEFAULT_DB));
          return JSON.parse(JSON.stringify(DEFAULT_DB));
        }
        const parsed = JSON.parse(raw);
        return {
          adminAuth: parsed.adminAuth || DEFAULT_DB.adminAuth,
          technicians: Array.isArray(parsed.technicians) ? parsed.technicians : DEFAULT_DB.technicians,
          services: Array.isArray(parsed.services) ? parsed.services : DEFAULT_DB.services,
          orders: Array.isArray(parsed.orders) ? parsed.orders : DEFAULT_DB.orders,
          reviews: Array.isArray(parsed.reviews) ? parsed.reviews : DEFAULT_DB.reviews
        };
      } catch (e) {
        return JSON.parse(JSON.stringify(DEFAULT_DB));
      }
    }

    let db = loadDatabase();

    function saveDatabase() {
      try {
        localStorage.setItem(APP_CONFIG.dbStorageKey, JSON.stringify(db));
      } catch (e) {
        showToast('تعذر حفظ البيانات في التخزين المحلي.');
      }
    }

    function showToast(msg) {
      const banner = $id('toast-banner');
      const text = $id('toast-text');
      if (!banner || !text) return;
      text.textContent = msg;
      banner.classList.remove('hidden');
      banner.classList.add('flex');
      clearTimeout(window.__toastTimer);
      window.__toastTimer = setTimeout(() => {
        banner.classList.add('hidden');
        banner.classList.remove('flex');
      }, 3600);
    }

    function exportDatabaseJSON() {
      const blob = new Blob([JSON.stringify(db, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `omar-pc-fix-backup-${toLocalIsoDate()}.json`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
      showToast('تم تحميل نسخة احتياطية JSON لقاعدة البيانات.');
    }

    function importDatabaseJSON(input) {
      if (!input || !input.files || !input.files[0]) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        try {
          const imported = JSON.parse(ev.target.result);
          if (!imported || !Array.isArray(imported.services) || !Array.isArray(imported.orders)) {
            showToast('ملف النسخة الاحتياطية غير صالح.');
            return;
          }
          db = {
            adminAuth: imported.adminAuth || db.adminAuth,
            technicians: Array.isArray(imported.technicians) ? imported.technicians : db.technicians,
            services: imported.services,
            orders: imported.orders,
            reviews: Array.isArray(imported.reviews) ? imported.reviews : db.reviews
          };
          saveDatabase();
          renderServicesGrid();
          renderReviews();
          initAndRenderSchedulePicker();
          syncBookingSnapshot();
          renderStaffWorkspace();
          showToast('تم استرجاع قاعدة البيانات بنجاح.');
        } catch (err) {
          showToast('حدث خطأ أثناء قراءة ملف JSON.');
        }
      };
      reader.readAsText(input.files[0]);
      input.value = '';
    }

