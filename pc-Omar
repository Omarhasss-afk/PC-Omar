            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-orange-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3a14 14 0 010 18M12 3a14 14 0 000 18" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">ISP / SPEED / IP LOCATION</div>
              <div id="hw-isp" class="text-xs font-bold text-orange-300 truncate-safe mt-1">Detecting ISP & Speed...</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-yellow-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">PSU DRAW</div>
              <div id="hw-psu" class="text-xs font-bold text-yellow-300 truncate-safe mt-1">85W • 230V AC</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
