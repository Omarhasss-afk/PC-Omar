                <circle cx="15" cy="12" r="2.2" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">GPU & CLOCK / DRIVER</div>
              <div id="hw-gpu" class="text-xs font-bold text-fuchsia-300 truncate-safe mt-1">1845 MHz • DRV v566.36 WHQL</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="8" width="18" height="8" rx="1.5" />
                <path d="M7 16v3M12 16v3M17 16v3" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">RAM & SPEED</div>
              <div id="hw-ram" class="text-xs font-bold text-cyan-300 truncate-safe mt-1">8 GB DDR5 • 4266 MHz</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-indigo-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3" y="4" width="18" height="14" rx="2" />
                <path d="M8 20h8M12 18v2" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">OS</div>
              <div id="hw-os" class="text-xs font-bold text-indigo-300 truncate-safe mt-1">Windows 11 Pro (x64)</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-rose-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M12 3l7 3v6c0 5-3 8-7 9-4-1-7-4-7-9V6l7-3z" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">SECURITY / LICENSE</div>
              <div id="hw-license" class="text-xs font-bold text-rose-300 truncate-safe mt-1">WIN: ACTIVATED • AV: LICENSED</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-teal-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
