        const safeName = escapeHtml(b.name);
        const safeSpec = escapeHtml(b.spec);
        const safeUrl = escapeHtml(b.url);
        const safeColor = /^#[0-9A-Fa-f]{6}$/.test(b.color) ? b.color : '#E11D48';
        return `
          <a href="${safeUrl}" target="_blank" rel="noopener noreferrer"
             title="${safeName} — ${safeSpec}"
             class="group bg-gray-900/90 hover:bg-gray-800 border border-gray-800 hover:border-crimson rounded-2xl p-3.5 flex flex-col items-center justify-start text-center transition min-w-0">
            <span class="w-8 h-8 rounded-xl flex items-center justify-center font-mono font-extrabold text-xs mb-2 transition-transform group-hover:scale-110 shrink-0"
                  style="background: ${safeColor}22; color: ${safeColor}; border: 1px solid ${safeColor}55;">
              ${code}
            </span>
            <span class="text-xs font-extrabold tracking-wide text-white group-hover:text-crimson transition truncate-safe w-full">${safeName}</span>
            <span class="text-[10px] text-gray-400 leading-snug mt-1 w-full">${safeSpec}</span>
          </a>
        `;
      }).join('');
    }

    function checkHashShortcut() {
      const h = (window.location.hash || '').toLowerCase();
      if (h === '#admin') openStaffLoginModal('admin');
      else if (h === '#tech' || h === '#staff') openStaffLoginModal('tech');
    }

    window.addEventListener('keydown', (e) => {
      if (e.ctrlKey && e.shiftKey && e.key.toLowerCase() === 's') {
        e.preventDefault();
        openStaffLoginModal('tech');
      }
    });

    window.addEventListener('hashchange', checkHashShortcut);

    window.addEventListener('DOMContentLoaded', () => {
      startLiveClock();
      applyLanguageUI();
      renderServicesGrid();
      renderReviews();
      detectOS();
      detectHardware();
      detectISPAndLocation();
      runStorageHealthCheck();
      renderManufacturersGrid();
      updateGauge('gauge-cpu', 'val-cpu', cpuTemp, 100, '°C');
      updateGauge('gauge-gpu', 'val-gpu', gpuTemp, 100, '°C');
      checkHashShortcut();
    });
  </script>
</body>
</html>
