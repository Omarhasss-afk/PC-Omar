  <!-- سكربت PowerShell المصلح -->
  <script type="text/plain" id="scan-ps1">
$ErrorActionPreference='SilentlyContinue'
Write-Host '== Home Computer Repair Service - Accurate Scan ==' -ForegroundColor Red
function G($c,$f){ try{ if($f){Get-CimInstance $c -Filter $f}else{Get-CimInstance $c} }catch{ $null } }
Write-Host '[1/6] System, board, BIOS, CPU'
$os=G Win32_OperatingSystem; $bb=G Win32_BaseBoard; $bi=G Win32_BIOS; $cpu=@(G Win32_Processor)[0]
$ct=@((G Win32_SystemEnclosure).ChassisTypes); $lap=[bool]($ct|?{$_ -in 8,9,10,11,14,30,31,32})
$arch=if($env:PROCESSOR_ARCHITECTURE -eq 'ARM64'){'ARM64'}else{'x64'}
$chip=$null; if("$($bb.Product)" -match '\b([ABHXZWQ]\d{3}E?)'){$chip=$Matches[1]}

Write-Host '[2/6] Memory and graphics'
$mem=@(G Win32_PhysicalMemory|?{$_ -ne $null})
$tmap=@{20='DDR';21='DDR2';24='DDR3';26='DDR4';27='LPDDR';28='LPDDR2';29='LPDDR3';30='LPDDR4';34='DDR5';35='LPDDR5'}
$firstMem=$mem|select -First 1
$mt=if($firstMem -and $firstMem.SMBIOSMemoryType){$tmap[[int]$firstMem.SMBIOSMemoryType]}else{$null}
$speeds=@($mem|%{ if([int]$_.ConfiguredClockSpeed -gt 0){[int]$_.ConfiguredClockSpeed}elseif([int]$_.Speed -gt 0){[int]$_.Speed} })
$mts=if($speeds.Count -gt 0){($speeds|measure -Maximum).Maximum}else{$null}
$capSum=($mem|measure Capacity -Sum).Sum
$gb=if($capSum -gt 0){[math]::Round($capSum/1GB)}else{0}

$gl=@(G Win32_VideoController|?{$_ -ne $null})
$gpu=$gl|sort {if($_.Name -match 'NVIDIA|Radeon RX|Arc'){0}else{1}}|select -First 1
$dv=if($gpu){$gpu.DriverVersion}else{$null}
if($gpu -and $gpu.Name -match 'NVIDIA' -and $dv){
  $d=$dv.Replace('.','')
  if($d.Length -ge 5){$dv=$d.Substring($d.Length-5).Insert(3,'.')}
}
$gv=if(!$gpu){'Other'}elseif($gpu.Name -match 'NVIDIA'){'NVIDIA'}elseif($gpu.Name -match 'AMD|Radeon'){'AMD'}elseif($gpu.Name -match 'Intel'){'Intel'}else{'Other'}
$gt=$null;$gc=$null
try{
  $nv=(& nvidia-smi --query-gpu=temperature.gpu,clocks.max.gr --format=csv,noheader,nounits 2>$null|select -First 1)
  if($nv){$p=("$nv" -split ','); if($p.Count -ge 2){$gt=[int]$p[0].Trim();$gc=[int]$p[1].Trim()}}
}catch{}

Write-Host '[3/6] Drivers (this can take a few seconds)'
$cd=G Win32_PnPSignedDriver "DeviceName LIKE '%Chipset%' OR DeviceName LIKE '%SMBus%' OR DeviceName LIKE '%Management Engine%' OR DeviceName LIKE '%PCI Express Root%' OR DeviceName LIKE '%PSP%'"|sort DriverDate -Descending|select -First 1
