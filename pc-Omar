    function handleStaffLogin(e) {
      e.preventDefault();
      const username = $id('staff-username').value.trim();
      const password = $id('staff-password').value.trim();

      if (staffLoginTab === 'admin') {
        if (username === db.adminAuth.username && password === db.adminAuth.password) {
          currentStaffSession = {
            role: 'admin',
            userId: 'ADMIN-1',
            username: db.adminAuth.username,
            name: db.adminAuth.name,
            zone: 'جميع المناطق'
          };
          closeStaffLoginModal();
          updateStaffChip();
          renderStaffWorkspace();
          openStaffWorkspace();
          showToast('تم تسجيل دخول الأدمن مع توريث كامل صلاحيات الفني.');
          return;
        }
        showToast('بيانات دخول الأدمن غير صحيحة.');
        return;
      }

      const tech = db.technicians.find(t => t.username === username && t.password === password);
      if (tech) {
        currentStaffSession = {
          role: 'tech',
          userId: tech.id,
          username: tech.username,
          name: tech.name,
          zone: tech.zone,
          roleTitle: tech.roleTitle
        };
        closeStaffLoginModal();
        updateStaffChip();
        renderStaffWorkspace();
        openStaffWorkspace();
        showToast(`مرحباً ${tech.name} — تم عرض الطلبات المسندة إليك.`);
