  if($sw.Elapsed.TotalSeconds -gt 0){$wr=[math]::Round(128/$sw.Elapsed.TotalSeconds)}
  $b4=New-Object byte[] 4096; $sw.Restart(); $fs=New-Object IO.FileStream($f,'Open','Write','None',4096,'WriteThrough')
  1..15|%{$fs.Write($b4,0,4096);$fs.Flush($true)}; $fs.Close(); $sw.Stop()
