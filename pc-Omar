    function start90sTest() {
      isTesting = true;
      testTimeRemaining = APP_CONFIG.testDurationSec;

      cpuTemp = Math.max(44, cpuTemp);
      gpuTemp = Math.max(41, gpuTemp);
      cpuClock = Math.max(3.8, cpuClock);
      gpuClock = Math.max(1845, gpuClock);
      maxCpuTemp = Math.max(maxCpuTemp, cpuTemp);
      maxGpuTemp = Math.max(maxGpuTemp, gpuTemp);
      minFpsSeen = Math.min(minFpsSeen, currentFPS);
      maxFpsSeen = Math.max(maxFpsSeen, currentFPS);

      const label = $id('status-label');
      const dot = $id('status-dot');
      const ring = $id('power-ring');
      const icon = $id('power-icon');

      if (label) {
        label.textContent = 'STRESS TEST RUNNING (01:30)';
        label.className = 'text-[#FF1E38] font-bold uppercase truncate-safe';
      }
      if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-[#FF1E38] animate-ping inline-block shrink-0';
      if (ring) {
        ring.classList.add('testing-active');
        ring.style.background = 'conic-gradient(#FF1E38 0deg, rgba(225, 29, 72, 0.25) 0deg)';
      }
      if (icon) icon.classList.add('text-white', 'scale-105');

      showToast('بدأ اختبار 90 ثانية. اضغط زر الباور مجدداً للإيقاف وإرسال التقرير لواتساب.');

      let worker = null;
      try {
        const blob = new Blob([`
          onmessage = function() {
            let x = 0.0001;
            for (let i = 0; i < 4500000; i++) {
              x += Math.sin(i) * Math.cos(i);
            }
            postMessage(x);
          };
        `], { type: 'application/javascript' });
        worker = new Worker(URL.createObjectURL(blob));
      } catch (e) {}

      let frameCount = 0;
      let lastFpsTick = performance.now();
      let rafId = null;
      const canvas = $id('gpu-stress-canvas');
      const ctx = canvas ? canvas.getContext('2d') : null;

      const renderFrame = (now) => {
        if (!isTesting) return;
        frameCount++;
        if (ctx) {
          ctx.fillStyle = `rgb(${(frameCount * 11) % 255}, ${(frameCount * 5) % 255}, 90)`;
          ctx.fillRect(0, 0, 256, 256);
        }
        if (now - lastFpsTick >= 500) {
          const measured = Math.round((frameCount * 1000) / (now - lastFpsTick));
          currentFPS = Math.min(targetFPS, Math.max(48, Math.round((measured + 60) / 2)));
          minFpsSeen = Math.min(minFpsSeen, currentFPS);
          maxFpsSeen = Math.max(maxFpsSeen, currentFPS);
          frameCount = 0;
          lastFpsTick = now;
        }
        rafId = requestAnimationFrame(renderFrame);
      };
      rafId = requestAnimationFrame(renderFrame);

      testInterval = setInterval(() => {
        testTimeRemaining--;
        if (worker) worker.postMessage('run');

        const elapsed = APP_CONFIG.testDurationSec - testTimeRemaining;
        const progressRatio = Math.min(1, elapsed / APP_CONFIG.testDurationSec);
        const deg = Math.round(progressRatio * 360);
        if (ring) ring.style.background = `conic-gradient(#FF1E38 ${deg}deg, rgba(225, 29, 72, 0.22) ${deg}deg)`;

        const mins = String(Math.floor(testTimeRemaining / 60)).padStart(2, '0');
        const secs = String(testTimeRemaining % 60).padStart(2, '0');
        if (label) label.textContent = `STRESS TEST RUNNING (${mins}:${secs})`;

        cpuLoad = Math.min(99, Math.max(cpuLoad, 72 + progressRatio * 24) + (Math.random() * 6 - 3));
        gpuLoad = Math.min(98, Math.max(gpuLoad, 65 + progressRatio * 28) + (Math.random() * 6 - 3));
        cpuTemp = Math.min(94, Math.max(cpuTemp, 45 + progressRatio * 42) + (Math.random() * 3 - 1.2));
        gpuTemp = Math.min(91, Math.max(gpuTemp, 42 + progressRatio * 40) + (Math.random() * 3 - 1.2));
        cpuClock = Math.max(3.8, 3.8 + progressRatio * 0.9);
        gpuClock = Math.max(1845, 1845 + progressRatio * 615);
        psuWatts = Math.max(140, 140 + progressRatio * 240);

        maxCpuTemp = Math.max(maxCpuTemp, cpuTemp);
        maxGpuTemp = Math.max(maxGpuTemp, gpuTemp);

        updateGauge('gauge-cpu', 'val-cpu', cpuTemp, 100, '°C');
        updateGauge('gauge-gpu', 'val-gpu', gpuTemp, 100, '°C');

        const subCpu = $id('sub-cpu');
        const subGpu = $id('sub-gpu');
        const fpsEl = $id('val-fps-readout');
        const psuEl = $id('hw-psu');
        const scoreEl = $id('val-score');

        if (subCpu) subCpu.textContent = `${Math.round(cpuLoad)}% • ${cpuClock.toFixed(1)}GHz`;
        if (subGpu) subGpu.textContent = `${Math.round(gpuLoad)}% • ${Math.round(gpuClock)}MHz`;
        if (fpsEl) fpsEl.textContent = `${Math.round(currentFPS)} FPS / ${targetFPS} FPS (Live)`;
        if (psuEl) psuEl.textContent = `${Math.round(psuWatts)}W • 230V AC`;
        if (scoreEl) {
          const liveScore = Math.max(40, Math.round(98 - progressRatio * 26));
          scoreEl.textContent = `${liveScore}/100 • STRESS ACTIVE`;
        }

        if (testTimeRemaining <= 0) finishTest('اكتمل اختبار 90 ثانية');
      }, 1000);

      window.__stopStressHardware = () => {
        clearInterval(testInterval);
        cancelAnimationFrame(rafId);
        if (worker) worker.terminate();
      };
    }

    function finishTest(outcomeLabel) {
      if (typeof window.__stopStressHardware === 'function') {
        window.__stopStressHardware();
        window.__stopStressHardware = null;
      }
      isTesting = false;
      lastTestOutcome = outcomeLabel;

      const label = $id('status-label');
      const dot = $id('status-dot');
      const ring = $id('power-ring');
      const icon = $id('power-icon');
      const scoreEl = $id('val-score');
      const fpsEl = $id('val-fps-readout');

      if (label) {
        label.textContent = 'TEST FINISHED • DISPATCHED TO WHATSAPP';
        label.className = 'text-rose-400 font-bold uppercase truncate-safe';
      }
      if (dot) dot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 inline-block shrink-0';
      if (ring) {
        ring.classList.remove('testing-active');
        ring.style.background = 'conic-gradient(#E11D48 0deg, rgba(255, 255, 255, 0.08) 0deg)';
      }
      if (icon) icon.classList.remove('text-white', 'scale-105');
      if (fpsEl) fpsEl.textContent = `${Math.round(currentFPS)} FPS / ${targetFPS} FPS`;

      const finalScore = Math.max(42, Math.min(99, Math.round(100 - ((maxCpuTemp - 55) * 0.9) - ((maxGpuTemp - 55) * 0.7))));
      if (scoreEl) scoreEl.textContent = `${finalScore}/100 • ${outcomeLabel.includes('90') ? 'FULL TEST' : 'STOPPED'}`;

      applyAIDiagnosticsAndServices();
      sendReportWhatsApp(outcomeLabel);
      showToast(`${outcomeLabel} — تم تجهيز التقرير وإرساله لواتساب (01028509300).`);
    }

