<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Home Computer Repair Service | Omar fixes your device at your home</title>

  <!-- الخطوط ومكتبة Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Cairo', 'sans-serif'],
            mono: ['JetBrains Mono', 'monospace']
          },
          colors: {
            obsidian: '#0B0B0E',
            panel: '#111117',
            crimson: '#E11D48',
            crimsonDeep: '#C8001E',
            crimsonGlow: '#FF1E38'
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --dial: clamp(76px, 25vw, 156px);
    }

    body {
      font-family: 'Cairo', sans-serif;
      background-color: #0B0B0E;
      color: #111827;
      overflow-x: hidden;
    }

    .hero-bg {
      background:
        radial-gradient(circle at 50% 0%, rgba(225, 29, 72, 0.22) 0%, rgba(11, 11, 14, 0.96) 62%),
        #0B0B0E;
    }

    .gauge-container,
    .power-btn-wrapper {
      position: relative;
      width: var(--dial);
      height: var(--dial);
    }

    .gauge-container svg {
      transform: rotate(135deg);
      width: 100%;
      height: 100%;
    }

    .gauge-container::before {
      content: '';
      position: absolute;
      inset: 14%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(225, 29, 72, 0.14), transparent 70%);
    }

    .gauge-bg {
      fill: none;
      stroke: rgba(255, 255, 255, 0.1);
      stroke-width: 7;
      stroke-dasharray: 188.5 251.3;
      stroke-linecap: round;
    }

    .gauge-progress {
      fill: none;
      stroke: #E11D48;
      stroke-width: 7;
      stroke-linecap: round;
      transition: stroke-dasharray 0.45s cubic-bezier(0.2, 0.8, 0.2, 1), stroke 0.35s ease, filter 0.45s ease;
    }

    .gauge-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      width: 86%;
      padding: 0 2px;
      z-index: 1;
    }

    .gauge-text > div {
      font-size: calc(var(--dial) * 0.078);
      line-height: 1.1;
    }

    .gauge-text > div:nth-child(2) {
      font-size: calc(var(--dial) * 0.17);
    }

    .gauge-text > div:nth-child(3) {
      white-space: nowrap;
    }

    .g-desc {
      font: 600 clamp(9px, 2.4vw, 11px)/1.35 'JetBrains Mono', monospace;
      color: #9ca3af;
      margin-top: 0.55rem;
      text-align: center;
      max-width: calc(var(--dial) * 1.3);
      overflow-wrap: anywhere;
    }

    .power-btn-wrapper {
      border-radius: 50%;
      padding: 4px;
      background: conic-gradient(#E11D48 0%, rgba(255, 255, 255, 0.08) 0%);
      transition: transform 0.25s ease, box-shadow 0.35s ease, background 0.3s ease;
      box-shadow: 0 0 24px rgba(225, 29, 72, 0.28);
    }

    .power-btn-wrapper:hover {
      transform: scale(1.04);
      box-shadow: 0 0 38px rgba(255, 30, 56, 0.52);
    }

    .power-btn-wrapper.testing-active {
      box-shadow: 0 0 42px rgba(255, 30, 56, 0.85), inset 0 0 18px rgba(225, 29, 72, 0.42);
      animation: pulseCrimsonActive 1.25s infinite ease-in-out;
    }

    @keyframes pulseCrimsonActive {
      0%, 100% {
        box-shadow: 0 0 26px rgba(255, 30, 56, 0.62), inset 0 0 14px rgba(225, 29, 72, 0.32);
      }
      50% {
        box-shadow: 0 0 48px rgba(255, 30, 56, 0.95), inset 0 0 22px rgba(225, 29, 72, 0.52);
      }
    }

    .power-btn-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: radial-gradient(circle at 50% 35%, #1E1318 0%, #0B0B0E 78%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      border: 2px solid rgba(255, 255, 255, 0.14);
      cursor: pointer;
      position: relative;
      overflow: hidden;
      transition: background 0.3s ease, border-color 0.3s ease;
    }

    .power-btn-wrapper.testing-active .power-btn-inner {
      background: radial-gradient(circle at 50% 35%, #E11D48 0%, #7F091A 65%, #240409 100%);
      border-color: #FF1E38;
    }

    .power-btn-inner::after {
      content: '';
      position: absolute;
      inset: 5px;
      border-radius: 50%;
      border: 1px dashed rgba(255, 30, 56, 0.45);
      pointer-events: none;
    }

    .power-btn-inner svg {
      width: 34%;
      height: 34%;
    }

    #hw-grid {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 16.5rem), 1fr));
    }

    .hw-wide {
      grid-column: 1 / -1;
    }

    .hw-pill {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.11);
      border-radius: 1.15rem;
      overflow: hidden;
      align-items: flex-start;
      transition: border-color 0.25s ease, background 0.25s ease, transform 0.2s ease;
    }

    .hw-pill:hover {
      border-color: rgba(255, 30, 56, 0.55);
      background: rgba(255, 255, 255, 0.07);
      transform: translateY(-1px);
    }

    .ai-thumb {
      width: clamp(30px, 8vw, 38px);
      height: clamp(30px, 8vw, 38px);
      border-radius: 9999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: radial-gradient(circle at 30% 25%, rgba(225, 29, 72, 0.28), rgba(15, 23, 42, 0.92));
      backdrop-filter: blur(6px);
      transition: box-shadow 0.25s, border-color 0.25s, transform 0.25s;
    }

    .ai-thumb svg {
      width: 56%;
      height: 56%;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .hw-pill:hover .ai-thumb {
      border-color: #FF1E38;
      box-shadow: 0 0 14px rgba(255, 30, 56, 0.55);
      transform: scale(1.06);
    }

    .hw-bad .ai-thumb {
      border-color: #FF1E38;
      box-shadow: 0 0 12px rgba(255, 30, 56, 0.6);
    }

    .hw-bad .ai-thumb svg {
      color: #FF4D63;
    }

    .truncate-safe {
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
      overflow-wrap: anywhere;
    }

    .hw-pill .text-xs {
      font-size: clamp(11px, 3.1vw, 13px);
    }

    .hw-d {
      font: 500 10.5px/1.5 Cairo, sans-serif;
      color: #9ca3af;
      margin-top: 0.3rem;
      overflow-wrap: anywhere;
    }

    .custom-input {
      width: 100%;
      border: 1px solid #E5E7EB;
      border-radius: 0.75rem;
      padding: 0.72rem 1rem;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
    }

    .custom-input:focus {
      border-color: #E11D48;
      box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.14);
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- شريط الإشعارات -->
  <div id="toast-banner" class="fixed bottom-5 left-5 z-50 hidden max-w-sm bg-[#0B0B0E] text-white border border-crimson/60 px-5 py-3.5 rounded-2xl shadow-2xl items-center gap-3">
    <span class="text-crimson text-lg">●</span>
    <span id="toast-text" class="text-sm font-semibold"></span>
  </div>

  <!-- الهيدر العلوي -->
  <header class="bg-[#0B0B0E] text-white py-3.5 px-4 sm:px-6 flex flex-wrap justify-between items-center gap-3 shadow-lg border-b border-gray-900 sticky top-0 z-40">
    <a href="#" class="flex items-center gap-2.5">
      <span class="text-2xl">🖥️</span>
      <div>
        <span class="text-base sm:text-xl font-black tracking-wide block leading-none">Home Computer Repair Service</span>
        <span id="brand-desc" class="block text-[10px] sm:text-xs text-gray-400 font-semibold mt-1">عمر بيجيلك البيت ويصلّح جهازك في مكانك.</span>
      </div>
    </a>

    <div class="flex items-center gap-2 sm:gap-3">
      <span id="header-clock-badge" class="hidden md:inline-block font-mono text-[11px] text-gray-300 bg-gray-900/90 border border-gray-800 px-3 py-1.5 rounded-xl"></span>

      <button type="button" id="lang-toggle-btn" onclick="toggleLanguage()" class="bg-gray-900 hover:bg-gray-800 text-white border border-gray-700 px-3 py-2 rounded-xl text-xs font-extrabold transition">
        English
      </button>

      <div id="active-staff-chip" class="hidden items-center gap-2 bg-rose-950/90 border border-rose-700/60 text-rose-100 px-3 py-1.5 rounded-xl text-xs font-bold">
        <span id="active-staff-label"></span>
        <button type="button" onclick="openStaffWorkspace()" class="bg-crimson hover:bg-crimsonGlow text-white px-2.5 py-0.5 rounded-lg font-extrabold transition">
          فتح اللوحة
        </button>
        <button type="button" onclick="logoutStaff()" class="bg-gray-900 hover:bg-gray-800 text-white px-2 py-0.5 rounded-lg font-bold transition">
          خروج
        </button>
      </div>

      <a id="header-cta-btn" href="#booking-section" class="bg-crimson hover:bg-crimsonGlow text-white px-4 py-2 rounded-xl text-xs sm:text-sm font-bold transition">
        احجز في مكانك
      </a>
    </div>
  </header>

  <!-- مساحة عمل الأدمن والفني -->
  <section id="staff-workspace-section" class="hidden bg-[#0E0E14] text-white py-9 px-3 sm:px-6 border-b border-gray-800">
    <div id="staff-workspace-body" class="max-w-6xl mx-auto"></div>
  </section>

  <!-- قسم الفحص واختبار الأداء -->
  <section class="hero-bg text-white pt-8 pb-14 px-3 sm:px-6">
    <div class="max-w-5xl mx-auto text-center">
      <h1 id="hero-main-title" class="text-3xl sm:text-5xl font-black mb-6 leading-tight">
        استعد أقصى أداء لجهازك! <br><span class="text-crimson">فحص وتشخيص شامل في ضغطة واحدة</span>
      </h1>

      <div class="bg-[#111117] rounded-3xl p-4 sm:p-7 border border-gray-800 shadow-2xl relative max-w-5xl mx-auto">

        <div class="flex flex-wrap items-center justify-between gap-2 pb-3 mb-6 border-b border-gray-800/80 text-[11px] sm:text-xs font-mono">
          <div class="flex items-center gap-2 min-w-0">
            <span id="status-dot" class="w-2.5 h-2.5 rounded-full bg-rose-500 inline-block shrink-0"></span>
            <span id="live-datetime" class="text-white font-bold uppercase tracking-wider truncate-safe">LOADING DATE & TIME...</span>
          </div>
          <span id="status-label" class="text-crimson font-bold uppercase truncate-safe">DIAGNOSTIC READY</span>
        </div>

        <!-- صف العدادات الثلاث -->
        <div class="grid grid-cols-3 items-center justify-items-center mb-7 px-0" style="gap: clamp(6px, 3vw, 48px);">
          <div class="flex flex-col items-center min-w-0">
            <div class="gauge-container">
              <svg viewBox="0 0 100 100">
                <circle class="gauge-bg" cx="50" cy="50" r="40"></circle>
                <circle id="gauge-gpu" class="gauge-progress" cx="50" cy="50" r="40" stroke-dasharray="0, 251.3"></circle>
              </svg>
              <div class="gauge-text">
                <div class="text-[8px] sm:text-[10px] text-gray-400 font-mono uppercase tracking-tight">GPU</div>
                <div id="val-gpu" class="text-sm sm:text-xl font-extrabold text-white leading-tight my-0.5">41°C</div>
                <div id="sub-gpu" class="text-[8px] sm:text-[10px] font-mono text-rose-400 font-bold whitespace-nowrap leading-none">12% • 1845MHz</div>
              </div>
            </div>
            <span id="gpu-desc" class="g-desc">GPU TEMP & CLOCK</span>
          </div>

          <div class="flex flex-col items-center justify-center shrink-0">
            <div id="power-ring" class="power-btn-wrapper">
              <button type="button" onclick="powerClick()" class="power-btn-inner" aria-label="تشغيل أو إيقاف الفحص">
                <svg id="power-icon" class="w-9 h-9 sm:w-11 sm:h-11 text-rose-500 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4" d="M12 3v9m6.364-6.364a9 9 0 11-12.728 0"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="flex flex-col items-center min-w-0">
            <div class="gauge-container">
              <svg viewBox="0 0 100 100">
                <circle class="gauge-bg" cx="50" cy="50" r="40"></circle>
                <circle id="gauge-cpu" class="gauge-progress" cx="50" cy="50" r="40" stroke-dasharray="0, 251.3"></circle>
              </svg>
              <div class="gauge-text">
                <div class="text-[8px] sm:text-[10px] text-gray-400 font-mono uppercase tracking-tight">CPU</div>
                <div id="val-cpu" class="text-sm sm:text-xl font-extrabold text-white leading-tight my-0.5">44°C</div>
                <div id="sub-cpu" class="text-[8px] sm:text-[10px] font-mono text-rose-400 font-bold whitespace-nowrap leading-none">18% • 3.8GHz</div>
              </div>
            </div>
            <span id="cpu-desc" class="g-desc">CPU TEMP & CLOCK</span>
          </div>
        </div>

        <!-- كبسولات العتاد والنظام -->
        <div id="hw-grid" class="grid gap-2.5 mb-4 text-left font-mono" dir="ltr">
          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-sky-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="4" y="4" width="16" height="16" rx="2" />
                <path d="M9 9h6v6H9z" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">MOTHERBOARD</div>
              <div id="hw-mobo" class="text-xs font-bold text-sky-300 truncate-safe mt-1">Detecting Board...</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="7" y="7" width="10" height="10" rx="1.5" />
                <path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">INTERNAL CHIPSET</div>
              <div id="hw-chipset" class="text-xs font-bold text-amber-300 truncate-safe mt-1">Detecting PCH...</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M6 12a6 6 0 1112 0c0 2.5-1.5 4.5-3.5 5.5L13 21h-2l-1.5-3.5C7.5 16.5 6 14.5 6 12z" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">BIOS MODEL</div>
              <div id="hw-bios" class="text-xs font-bold text-purple-300 truncate-safe mt-1">Detecting BIOS...</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-rose-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="6" y="6" width="12" height="12" rx="2" />
                <path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" />
              </svg>
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-[9px] text-gray-400 uppercase leading-none">CPU & CLOCK</div>
              <div id="hw-cpu" class="text-xs font-bold text-rose-300 truncate-safe mt-1">4 Cores • 8 Threads • 3.8 GHz</div>
            </div>
          </div>

          <div class="hw-pill px-3.5 py-2.5 min-w-0 flex items-center gap-2.5">
            <span class="ai-thumb" aria-hidden="true">
              <svg class="w-4 h-4 text-fuchsia-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
