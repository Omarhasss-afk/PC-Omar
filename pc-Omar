    function renderTimeSlotsForDay() {
      const grid = $id('booking-times-grid');
      const preview = $id('selected-slot-preview');
      $id('booking-date').value = selectedBookingDate;

      if (!grid) return;

      const firstAvailable = TIME_SLOTS_10_TO_8.find(s => !isSlotBooked(selectedBookingDate, s.id));
      if (!selectedBookingSlot && firstAvailable) {
